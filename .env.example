# AdSense (opcional)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RECETA=
NEXT_PUBLIC_ADSENSE_SLOT_LISTADO=

# Google Analytics 4 (opcional) — Measurement ID de la propiedad GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase (auth, valoraciones, comentarios, favoritos cloud)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Emails con rol admin (coma-separados). Se aplican al login / middleware.
ADMIN_EMAILS=tu@email.com

# Amazon afiliados (opcional)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
